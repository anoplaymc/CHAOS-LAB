-- Furniture Pack: new physical props, made entirely of data.

local WOOD = 0x9a6a3a
local DARK = 0x4a3220
local FABRIC = 0xa04848

register.material{
  id = "cushion",
  name = { en = "Cushion", ru = "Подушка" },
  friction = 1.0,
  restitution = 0.35,
  density = 25,
  sound = "rubber",
  fragility = 0,
  tint = FABRIC,
}

-- Four legs under a rectangular top. Local helper: scripts can build their model tables however they like.
local function legs(w, d, h, y, color)
  local parts = {}
  for _, sx in ipairs({-1, 1}) do
    for _, sz in ipairs({-1, 1}) do
      table.insert(parts, { shape = "box", size = {0.07, h, 0.07}, pos = {sx * (w - 0.07) / 2, y, sz * (d - 0.07) / 2}, color = color })
    end
  end
  return parts
end

local function with(parts, more)
  for _, p in ipairs(more) do table.insert(parts, p) end
  return parts
end

register.prop{
  id = "dining_chair",
  name = { en = "Dining Chair", ru = "Обеденный стул" },
  desc = { en = "Throw it. Everyone does.", ru = "Бросьте его. Все так делают." },
  shape = { type = "box", size = {0.5, 1, 0.5} },
  material = "wood",
  break_speed = 8,
  health = 25,
  debris = "wood",
  debris_count = 5,
  model = with(legs(0.5, 0.5, 0.46, -0.27, DARK), {
    { shape = "box", size = {0.5, 0.05, 0.5}, pos = {0, -0.03, 0}, color = WOOD },
    { shape = "box", size = {0.5, 0.45, 0.04}, pos = {0, 0.24, -0.23}, color = WOOD },
  }),
}

register.prop{
  id = "dining_table",
  name = { en = "Dining Table", ru = "Обеденный стол" },
  desc = { en = "Seats six, launches them too.", ru = "На шестерых. И запускает всех шестерых." },
  shape = { type = "box", size = {2.2, 0.8, 1} },
  material = "wood",
  break_speed = 12,
  health = 90,
  debris = "wood",
  debris_count = 8,
  model = with(legs(2.2, 1, 0.74, -0.03, DARK), {
    { shape = "box", size = {2.2, 0.07, 1}, pos = {0, 0.365, 0}, color = WOOD },
  }),
}

register.prop{
  id = "armchair",
