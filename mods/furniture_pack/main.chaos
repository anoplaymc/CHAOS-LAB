-- Interactive: E toggles a light. Per-entity state goes in entity data, which saved games keep.
register.prop{
  id = "desk_lamp",
  name = { en = "Desk Lamp", ru = "Настольная лампа" },
  desc = { en = "Press E to switch it on.", ru = "Нажмите E, чтобы включить." },
  shape = { type = "cylinder", r = 0.14, h = 0.55 },
  material = "metal",
  prompt = { en = "E  Switch", ru = "E  Переключить" },
  model = {
    { shape = "cylinder", r = 0.14, h = 0.04, pos = {0, -0.25, 0}, material = "steel_dark" },
    { shape = "cylinder", r = 0.02, h = 0.45, pos = {0, -0.02, 0}, material = "steel" },
    { shape = "cone", r = 0.14, h = 0.14, pos = {0, 0.22, 0}, material = "paint_amber" },
  },
  on_interact = function(self)
    local on = not entity.get_data(self, "on")
    entity.set_data(self, "on", on)
    sound.play("lever", 0.6, entity.position(self))
    entity.set_tint(self, on and 0xfff0a0 or nil)
    return true
  end,
  tick_rate = 0.4,
  on_tick = function(self, dt)
    if entity.get_data(self, "on") then
      fx.flash(entity.position(self), 0xffe0a0, 8)
    end
  end,
}

-- Uses an image from assets/, declared in mod.json.
register.prop{
  id = "poster",
  name = { en = "Safety Poster", ru = "Плакат по безопасности" },
  desc = { en = "Stands against a wall, ignored by everyone.", ru = "Стоит у стены, и все его игнорируют." },
  shape = { type = "box", size = {1, 1.4, 0.06} },
  material = "wood",
  break_speed = 4,
  health = 8,
  debris = "wood",
  model = {
    { shape = "box", size = {1, 1.4, 0.05}, texture = "assets/poster.png" },
  },
}

log.info("Furniture Pack ready")
