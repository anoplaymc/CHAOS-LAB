local blocks = {
  { pos = {0, -0.5, 0}, size = {50, 1, 50}, material = "concrete" },
  { pos = {0, 2, -25.5}, size = {51, 6, 1}, material = "wall_light" },
  { pos = {0, 2, 25.5}, size = {51, 6, 1}, material = "wall_light" },
  { pos = {-25.5, 2, 0}, size = {1, 6, 51}, material = "wall_light" },
  { pos = {25.5, 2, 0}, size = {1, 6, 51}, material = "wall_light" },
}

register.map{
  id = "yard",
  name = "Small Yard",
  desc = "Four walls and a floor.",
  spawn = {x = 0, y = 0, z = 15},
  blocks = blocks,
  sky = "day",
}

local GOAL = 10
local broken = 0

events.on("entity_broken", function(e)
  if mode.is_mine() then broken = broken + 1 end
end)

register.mode{
  id = "smash",
  name = "Crate Smash",
  desc = "Break ten crates.",
  map = "yard",
  on_start = function()
    broken = 0
    for i = 1, GOAL * 2 do
      entity.spawn("crate_wood", {x = math.random(-15, 15), y = 1 + i, z = math.random(-15, 15)})
    end
  end,
  on_tick = function(dt)
    if broken >= GOAL then
      local best = storage.get("wins", 0) + 1
      storage.set("wins", best)
      mode.finish{ win = true, title = "Smashed", detail = "Wins so far: " .. best, can_continue = true }
    end
  end,
  hud = function()
    return { title = "Crate Smash", lines = { broken .. " / " .. GOAL } }
  end,
}
